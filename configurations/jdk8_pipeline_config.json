{
  "version": "jdk8",
  "buildConfigurations": {
    "x86-64_mac": {
      "os": "mac",
      "arch": "x64",
      "additionalNodeLabels": {
        "temurin": "sw.tool.xcode.11_7",
        "openj9": "sw.os.mac.10_14"
      },
      "configureArgs": {
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": ""
      }
    },
    "x86-64_linux": {
      "os": "linux",
      "arch": "x64",
      "dockerImage": "adoptopenjdk/centos6_build_image",
      "dockerFile": {
        "openj9": "pipelines/build/dockerFiles/cuda.dockerfile",
        "dragonwell": "pipelines/build/dockerFiles/dragonwell.dockerfile"
      },
      "configureArgs": {
        "dragonwell": "--enable-unlimited-crypto --with-jvm-variants=server  --with-zlib=system",
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": "--create-source-archive --enable-sbom-strace"
      }
    },
    "x86-64_alpine-linux": {
      "os": "alpine-linux",
      "arch": "x64",
      "dockerImage": "adoptopenjdk/alpine3_build_image",
      "configureArgs": {
        "openj9": "--disable-headful",
        "temurin": "--disable-headful --disable-ccache"
      },
      "buildArgs": {
        "temurin": "--enable-sbom-strace"
      }
    },
    "aarch64_alpine-linux": {
      "os": "alpine-linux",
      "arch": "aarch64",
      "dockerImage": "adoptopenjdk/alpine3_build_image",
      "configureArgs": {
        "openj9": "--disable-headful",
        "temurin": "--disable-headful --disable-ccache --with-jobs=4"
      },
      "buildArgs": {
        "temurin": "--enable-sbom-strace"
      }
    },
    "x86-64_windows": {
      "os": "windows",
      "arch": "x64",
      "dockerImage": "windows2022_build_image@sha256:0d0a3afb998c34df0277d6a5ed97c2d8d705012e6a93d358af25af638963ef6f",
      "dockerRegistry": "https://adoptium.azurecr.io",
      "dockerCredential": "bbb9fa70-a1de-4853-b564-5f02193329ac",
      "additionalNodeLabels": "sw.os.windows.2022&&sw.tool.vs.2022",
      "configureArgs": {
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": "--use-adoptium-devkit vs2022_redist_14.40.33807_10.0.26100.1742"
      }
    },
    "x86-32_windows": {
      "os": "windows",
      "arch": "x86-32",
      "dockerImage": "windows2022_build_image@sha256:0d0a3afb998c34df0277d6a5ed97c2d8d705012e6a93d358af25af638963ef6f",
      "dockerRegistry": "https://adoptium.azurecr.io",
      "dockerCredential": "bbb9fa70-a1de-4853-b564-5f02193329ac",
      "additionalNodeLabels": "sw.os.windows.2022",
      "configureArgs": {
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": "--jvm-variant client,server --use-adoptium-devkit vs2022_redist_14.40.33807_10.0.26100.1742"
      }
    },
    "ppc64_aix": {
      "os": "aix",
      "arch": "ppc64",
      "additionalNodeLabels": "sw.tool.xlc.13&&sw.os.aix.7_2",
      "cleanWorkspaceAfterBuild": true,
      "configureArgs": {
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": ""
      }
    },
    "s390x_linux": {
      "os": "linux",
      "arch": "s390x",
      "dockerImage": "rhel7_build_image",
      "configureArgs": {
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": "--enable-sbom-strace"
      }
    },
    "sparcv9_solaris": {
      "os": "solaris",
      "arch": "sparcv9",
      "configureArgs": {
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": ""
      }
    },
    "x86-64_solaris": {
      "os": "solaris",
      "arch": "x64",
      "configureArgs": {
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": ""
      }
    },
    "ppc64le_linux": {
      "os": "linux",
      "arch": "ppc64le",
      "dockerImage": "adoptopenjdk/centos7_build_image",
      "configureArgs": {
        "temurin": "--disable-ccache"
      },
      "buildArgs": {
        "temurin": "--enable-sbom-strace"
      }
    },
    "arm_linux": {
      "os": "linux",
      "arch": "arm",
      "crossCompile": "aarch64",
      "dockerImage": "adoptopenjdk/ubuntu1604_build_image",
      "dockerArgs": "--platform linux/arm/v7",
      "configureArgs": {
        "temurin": "--disable-ccache --with-jobs=4"
      },
      "buildArgs": {
        "temurin": "--enable-sbom-strace"
      }
    },
    "aarch64_linux": {
      "os": "linux",
      "arch": "aarch64",
      "dockerImage": "adoptopenjdk/centos7_build_image",
      "dockerFile": {
        "dragonwell": "pipelines/build/dockerFiles/dragonwell_aarch64.dockerfile"
      },
      "configureArgs": {
        "temurin": "--disable-ccache --with-jobs=4"
      },
      "buildArgs": {
        "temurin": "--enable-sbom-strace"
      }
    }
  },
  "targetConfigurations": [
    "x86-64_mac",
    "x86-64_linux",
    "x86-64_alpine-linux",
    "aarch64_alpine-linux",
    "x86-64_windows",
    "x86-32_windows",
    "ppc64_aix",
    "s390x_linux",
    "sparcv9_solaris",
    "x86-64_solaris",
    "ppc64le_linux",
    "arm_linux",
    "aarch64_linux"
  ],
  "openjdkVersion": "jdk8u",
  "enabled": true
}