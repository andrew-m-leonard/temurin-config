{
  "pipelineBaseFolder": "Adoptium_Pipelines",
  "jenkinsfilePath": "ci/jenkins/Jenkinsfile.declarative",
  "pipelineTimeoutHours": 25,
  "stageAgentLabels": {
    "__any__": "ci.role.worker",
    "010-initialize": "ci.role.worker",
    "020-build": "ci.role.build&&sw.os.{os}&&hw.arch.{arch}",
    "030-internal-code-sign": "eclipse-codesign",
    "040-assemble-images": "ci.role.build&&sw.os.{os}&&hw.arch.{arch}",
    "060-post-build-code-sign": "ci.role.worker",
    "070-installer": "ci.role.build&&sw.os.{os}&&hw.arch.{arch}",
    "080-code-sign-installer": "ci.role.worker",
    "090-sbom-sign": "ci.role.worker",
    "100-digital-artifact-sign": "ci.role.worker",
    "110-verify-signing": "ci.role.worker",
    "120-validate-sbom": "ci.role.worker",
    "130-smoke-tests": "ci.role.test&&sw.os.{os}&&hw.arch.{arch}",
    "140-aqa-tests": "ci.role.test&&hw.arch.{arch}",
    "150-tck-tests": "ci.role.test&&hw.arch.{arch}",
    "190-publish": "ci.role.worker",
    "200-reproducible-compare": "ci.role.test.repro&&sw.os.{os}&&hw.arch.{arch}"
  },
  "deployments": [
    {
      "name": "release",
      "folder": "release",
      "description": "Production release pipeline — restricted access, manual publish gate",
      "jobConfiguration": {
        "defaultParameters": {
          "VARIANT": "temurin",
          "CLEAN_WORKSPACE_AFTER_STAGE": true,
          "CREATE_SBOM": true,
          "RUN_TESTS": true,
          "ENABLE_INSTALLERS": true,
          "SIGN_ARTIFACTS": true,
          "PUBLISH_ARTIFACTS": true,
          "RUN_REPRODUCIBLE_COMPARE": false,
          "RELEASE_TYPE": "RELEASE"
        },
        "logRotation": {
          "daysToKeep": 250,
          "numToKeep": 60,
          "artifactDaysToKeep": 250,
          "artifactNumToKeep": 60
        }
      },
      "authorization": {
        "inheritParent": false,
        "permissions": [
          { "permission": "Job/Build", "grantee": "AdoptOpenJDK*build" },
          { "permission": "Job/Cancel", "grantee": "AdoptOpenJDK*build" },
          { "permission": "Job/Configure", "grantee": "AdoptOpenJDK*build" },
          { "permission": "Job/Read", "grantee": "AdoptOpenJDK*build" },
          { "permission": "Job/Workspace", "grantee": "AdoptOpenJDK*build" },
          { "permission": "Run/Update", "grantee": "AdoptOpenJDK*build" },
          { "permission": "Job/Build", "grantee": "AdoptOpenJDK*build-triage" },
          { "permission": "Job/Cancel", "grantee": "AdoptOpenJDK*build-triage" },
          { "permission": "Job/Configure", "grantee": "AdoptOpenJDK*build-triage" },
          { "permission": "Job/Read", "grantee": "AdoptOpenJDK*build-triage" },
          { "permission": "Job/Workspace", "grantee": "AdoptOpenJDK*build-triage" },
          { "permission": "Run/Update", "grantee": "AdoptOpenJDK*build-triage" },
          { "permission": "Job/Read", "grantee": "eclipse-temurin-bot" },
          { "permission": "Job/Read", "grantee": "eclipse-temurin-compliance-bot" }
        ]
      },
      "triggers": [
        { "type": "detect-ga-tag", "cronSchedule": "H * 15-31 * *" }
      ]
    },
    {
      "name": "beta",
      "folder": "beta",
      "description": "EA/beta and weekly HEAD development pipeline",
      "jobConfiguration": {
        "defaultParameters": {
          "VARIANT": "temurin",
          "CLEAN_WORKSPACE_AFTER_STAGE": true,
          "CREATE_SBOM": true,
          "RUN_TESTS": true,
          "ENABLE_INSTALLERS": true,
          "SIGN_ARTIFACTS": true,
          "PUBLISH_ARTIFACTS": true,
          "RUN_REPRODUCIBLE_COMPARE": false,
          "RELEASE_TYPE": "WEEKLY"
        },
        "logRotation": {
          "daysToKeep": 250,
          "numToKeep": 60,
          "artifactDaysToKeep": 250,
          "artifactNumToKeep": 2
        }
      },
      "triggers": [
        { "type": "detect-build-tag-for-github-release", "cronSchedule": "H 20 * * *" },
        { "type": "weekly-head", "cronSchedule": "H 7 * * 6" }
      ]
    }
  ]
}
