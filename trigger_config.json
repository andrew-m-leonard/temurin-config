{
  "triggers": [
    {
      "type": "detect-ga-tag",
      "versions": [
        {
          "version": "jdk8",
          "monitorRepo":     "https://github.com/adoptium/jdk8u.git",
          "gaTagPattern":    "jdk8u[0-9]+-ga$",
          "buildTagPattern": "jdk8u[0-9]+-b[0-9]+_adopt$",
          "enabled": true
        },
        {
          "version": "jdk11",
          "monitorRepo":     "https://github.com/adoptium/jdk11u.git",
          "gaTagPattern":    "jdk-11[0-9.]*-ga$",
          "buildTagPattern": "jdk-11[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "enabled": true
        },
        {
          "version": "jdk17",
          "monitorRepo":     "https://github.com/adoptium/jdk17u.git",
          "gaTagPattern":    "jdk-17[0-9.]*-ga$",
          "buildTagPattern": "jdk-17[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "enabled": true
        },
        {
          "version": "jdk21",
          "monitorRepo":     "https://github.com/adoptium/jdk21u.git",
          "gaTagPattern":    "jdk-21[0-9.]*-ga$",
          "buildTagPattern": "jdk-21[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "enabled": true
        },
        {
          "version": "jdk27",
          "monitorRepo":     "https://github.com/adoptium/jdk27u.git",
          "gaTagPattern":    "jdk-27[0-9.]*-ga$",
          "buildTagPattern": "jdk-27[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "enabled": true
        },
        {
          "version": "jdk28",
          "monitorRepo":     "https://github.com/adoptium/jdk.git",
          "gaTagPattern":    "jdk-28[0-9.]*-ga$",
          "buildTagPattern": "jdk-28[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "enabled": true
        }
      ]
    },
    {
      "type": "detect-build-tag-for-github-release",
      "versions": [
        {
          "version": "jdk8",
          "monitorRepo":         "https://github.com/adoptium/jdk8u.git",
          "targetRepo":          "https://github.com/adoptium/temurin8-binaries",
          "buildTagPattern":     "jdk8u[0-9]+-b[0-9]+_adopt$",
          "publishNameMap":      "s/_adopt$/-ea/",
          "targetReleaseTagMap": "s/$/-beta/",
          "suppressTestingConditions": [
            {
              "param": "RELEASE_TYPE",
              "value": "WEEKLY",
              "window": { "event": "OPENJDK_RELEASE_DAY", "daysBefore": 0, "daysAfter": 7 }
            }
          ],
          "enabled": true
        },
        {
          "version": "jdk11",
          "monitorRepo":         "https://github.com/adoptium/jdk11u.git",
          "targetRepo":          "https://github.com/adoptium/temurin11-binaries",
          "buildTagPattern":     "jdk-11[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "publishNameMap":      "s/_adopt$/-ea/",
          "targetReleaseTagMap": "s/$/-beta/",
          "suppressTestingConditions": [
            {
              "param": "RELEASE_TYPE",
              "value": "WEEKLY",
              "window": { "event": "OPENJDK_RELEASE_DAY", "daysBefore": 0, "daysAfter": 7 }
            }
          ],
          "enabled": true
        },
        {
          "version": "jdk17",
          "monitorRepo":         "https://github.com/adoptium/jdk17u.git",
          "targetRepo":          "https://github.com/adoptium/temurin17-binaries",
          "buildTagPattern":     "jdk-17[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "publishNameMap":      "s/_adopt$/-ea/",
          "targetReleaseTagMap": "s/$/-beta/",
          "suppressTestingConditions": [
            {
              "param": "RELEASE_TYPE",
              "value": "WEEKLY",
              "window": { "event": "OPENJDK_RELEASE_DAY", "daysBefore": 0, "daysAfter": 7 }
            }
          ],
          "enabled": true
        },
        {
          "version": "jdk21",
          "monitorRepo":         "https://github.com/adoptium/jdk21u.git",
          "targetRepo":          "https://github.com/adoptium/temurin21-binaries",
          "buildTagPattern":     "jdk-21[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "publishNameMap":      "s/_adopt$/-ea/",
          "targetReleaseTagMap": "s/$/-beta/",
          "suppressTestingConditions": [
            {
              "param": "RELEASE_TYPE",
              "value": "WEEKLY",
              "window": { "event": "OPENJDK_RELEASE_DAY", "daysBefore": 0, "daysAfter": 7 }
            }
          ],
          "enabled": true
        },
        {
          "version": "jdk25",
          "monitorRepo":         "https://github.com/adoptium/jdk25u.git",
          "targetRepo":          "https://github.com/adoptium/temurin25-binaries",
          "buildTagPattern":     "jdk-25[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "publishNameMap":      "s/_adopt$/-ea/",
          "targetReleaseTagMap": "s/$/-beta/",
          "suppressTestingConditions": [
            {
              "param": "RELEASE_TYPE",
              "value": "WEEKLY",
              "window": { "event": "OPENJDK_RELEASE_DAY", "daysBefore": 0, "daysAfter": 7 }
            }
          ],
          "enabled": true
        },
        {
          "version": "jdk28",
          "monitorRepo":         "https://github.com/adoptium/jdk.git",
          "targetRepo":          "https://github.com/adoptium/temurin28-binaries",
          "buildTagPattern":     "jdk-28[0-9.]*\\+[0-9]+(\\.[0-9]+)?_adopt$",
          "publishNameMap":      "s/_adopt$/-ea/",
          "targetReleaseTagMap": "s/$/-beta/",
          "suppressTestingConditions": [
            {
              "param": "RELEASE_TYPE",
              "value": "WEEKLY",
              "window": { "event": "OPENJDK_RELEASE_DAY", "daysBefore": 0, "daysAfter": 7 }
            }
          ],
          "enabled": true
        }
      ]
    },
    {
      "type": "weekly-head",
      "versions": [
        { "version": "jdk27", "enabled": true }
      ]
    }
  ]
}
